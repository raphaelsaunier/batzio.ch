# Optional: public base URL used in emails, API docs and MCP metadata.
APP_URL=http://localhost:5173

# Optional: lets Batzio create and query tenant databases through the D1 HTTP API
# when the binding pool in config/tenant-databases.ts is exhausted.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_TOKEN=

# Shared demo account, shown on the sign-in page with a one-click login (and
# created with a demo company on first use). Locally, put these in .dev.vars.
# DEMO_LOGIN_EMAIL=demo@batzio.test
# DEMO_LOGIN_PASSWORD=batzio-demo-2026

# Batzi, the assistant (Claude). Without it, quick sentences and file imports still work.
# ANTHROPIC_API_KEY=
# Domain routed to the Worker with Cloudflare Email Routing, e.g. in.example.ch
# EMAIL_DOMAIN=

# Sending documents by email (Cloudflare Email Service): add a send_email binding
# named EMAIL to the Worker and set the sender address on your onboarded domain.
# EMAIL_FROM=documents@example.ch

# Moving in: API origin of the accounting software customers switch from,
# pre-filled on Settings → Move in. To try it locally, import from another
# Batzio company: http://127.0.0.1:5173/api/compat with one of its API keys.
# IMPORT_SOURCE_URL=
