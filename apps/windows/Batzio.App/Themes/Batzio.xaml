<?xml version="1.0" encoding="utf-8"?>
<!-- Batzio's look on Windows: metallic blue, neumorphic pages and buttons, plain fields.
     Control colours come from Tokens.xaml (generated lightweight-styling keys). -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Raised buttons: pill-shaped, soft. -->
    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource BzCornerRadiusPill}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontFamily" Value="{StaticResource BzSansFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BzMetalButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource BzCornerRadiusPill}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontFamily" Value="{StaticResource BzSansFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BzDisplayText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BzDisplayFont}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
